# Google Sheets API Configuration
# These values should be kept secret and only set in GitHub repository secrets
# Never commit actual values to this file

# Google API Key - MUST be restricted in Google Cloud Console
# See: https://console.cloud.google.com/apis/credentials
# Restriction: HTTP referrers (web sites) to your domain only
REACT_APP_GOOGLE_API_KEY=YOUR_RESTRICTED_API_KEY_HERE

# Google Sheet ID - the ID from your Google Sheet URL
# Format: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
REACT_APP_GOOGLE_SHEET_ID=YOUR_SHEET_ID_HERE

# Google Client ID for OAuth (optional)
REACT_APP_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID_HERE

# Google Apps Script Endpoint - URL of your Apps Script deployment
# Keep this secure as it contains sensitive functionality
REACT_APP_RSVP_ENDPOINT=YOUR_APPS_SCRIPT_ENDPOINT_HERE
